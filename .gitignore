# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gentle-ai / opencode
opencode.json.backup
.atl/

# Plantilla de variables de entorno (copiar a .env y completar; .env NO se versiona)
!.env.example

# Parches sueltos (P-36): los .patch quedan fuera de control de versiones
*.patch
# Excepción: si algún día se usa yarn patch protocol, sus parches sí se versionan
!.yarn/patches/*.patch

# Media de ejercicios (D-70): solo se versionan los mp4/jpg optimizados; los GIF originales pesan ~126 MB
# y lo que entra al historial de git no se puede sacar después.
public/**/*.gif
public/**/*.GIF

# Skill de diseño vendored (binario del engine, ~86 MB). Se instala con `npx impeccable install`;
# no se versiona.
.opencode/

# Capturas de pantalla locales (no son parte del producto).
/Captura de pantalla*.png
/*.png
