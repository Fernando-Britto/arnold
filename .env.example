# Copiar este archivo a `.env` y completar los valores. `.env` NO se versiona.

# Conexión a PostgreSQL (la usa Prisma).
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_DB"

# Clave con la que se firman los JWT de sesión.
# Obligatoria en producción: sin ella la app se niega a firmar/verificar tokens.
# Generar una larga y aleatoria, por ejemplo:  openssl rand -base64 48
JWT_SECRET="cambiar-por-un-valor-largo-y-aleatorio"
