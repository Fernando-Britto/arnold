// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USUARIOS Y ROLES
// ============================================================================

model Usuario {
  id            String   @id @default(cuid())
  nombre        String
  email         String   @unique
  password      String   // cifrada
  rol           Rol      @default(SOCIO)
  estado        EstadoUsuario @default(ACTIVO)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  // Relaciones polimórficas
  socio         Socio?
  empleado      Empleado?

  // Auditoría
  registrosAuditoria RegistroDeAuditoria[]
  auditoriaAcceso    AuditoriaAcceso[]

  // Sesiones extendidas (P-20)
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([rol])
}

enum Rol {
  ADMINISTRADOR
  INSTRUCTOR
  RECEPCIONISTA
  SOCIO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

// ============================================================================
// SOCIOS
// ============================================================================

model Socio {
  id            String   @id @default(cuid())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String   @unique
  dni           String   @unique
  telefono      String?
  fechaAlta     DateTime @default(now())
  estadoCuota   EstadoCuota @default(AL_DIA)
  /// PIN de 4 dígitos del check-in (DNI + PIN), guardado con bcrypt. Nunca en claro (D-47).
  pinHash       String?
  /// ID de la plantilla en el sensor (1..1000). La plantilla vive en el sensor, no en Arnold (D-43/D-47).
  huellaId      Int?     @unique
  /// Fecha del consentimiento informado para el tratamiento de la huella (Ley 25.326, P-30).
  huellaConsentimientoEn DateTime?
  /// Meta de peso corporal (kg) y el peso desde el que se fijó, para saber si el objetivo era bajar o subir (D-65).
  pesoObjetivo  Decimal? @db.Decimal(5, 2)
  pesoInicialDeMeta Decimal? @db.Decimal(5, 2)
  updatedAt     DateTime @updatedAt

  // Relaciones
  membresiaAsignada Membresia? @relation("MembresiaDelSocio", fields: [membresiaAsignadaId], references: [id], onDelete: SetNull)
  membresiaAsignadaId String?

  asistencias   Asistencia[]
  rutinasAsignadas RutinaAsignada[]  // relación indirecta a Rutina
  sesiones      SesionDeEntrenamiento[]
  registrosProgreso RegistroDeProgreso[]
  mediciones    MedicionDePeso[]
  cuotas        Cuota[]
  pagos         Pago[]  @relation("PagosDeSocio")
  auditoriaAcceso AuditoriaAcceso[]
  solicitudesHuella SolicitudDeHuella[]
  asignacionesDeEjercicio AsignacionDeEjercicio[]

  @@index([dni])
  @@index([estadoCuota])
  @@index([membresiaAsignadaId])
}

// ============================================================================
// HUELLAS (acceso biométrico) — T-041, D-43/D-47
// ============================================================================

/// Cola de enrolamientos/bajas que el sensor consulta por polling. La plantilla biométrica NUNCA
/// se persiste en Arnold (Ley 25.326): acá sólo vive la relación socio ↔ huellaId.
model SolicitudDeHuella {
  id          String   @id @default(cuid())
  socio       Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  socioId     String
  accion      AccionHuella
  huellaId    Int
  estado      EstadoSolicitudHuella @default(PENDIENTE)
  motivo      String?
  /// ID ya existente en el sensor cuando el enrolamiento encontró un duplicado.
  duplicadoDe Int?
  createdAt   DateTime @default(now())
  resueltaEn  DateTime?

  @@index([estado, createdAt])
  @@index([socioId])
}

enum AccionHuella {
  ENROLAR
  BORRAR
}

enum EstadoSolicitudHuella {
  PENDIENTE
  CONFIRMADA
  FALLIDA
}

enum EstadoCuota {
  // Estado de la CUENTA del socio (D-46/P-24): NO describe el pago. El pago se calcula
  // (`estadoCuotaSocio`, D-40) a partir de `Cuota`/`Pago` y nunca se persiste.
  // AL_DIA: cuenta habilitada (no significa "pagó el mes").
  AL_DIA
  // INACTIVA: cuenta deshabilitada por el gimnasio (baja/pausa).
  INACTIVA
  // BLOQUEADA: sanción/problema grave; deniega siempre.
  BLOQUEADA
}

// ============================================================================
// EMPLEADOS
// ============================================================================

model Empleado {
  id            String   @id @default(cuid())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String   @unique
  turno         Turno    @default(MANANA)
  estadoLaboral EstadoLaboral @default(ACTIVO)
  updatedAt     DateTime @updatedAt

  // Relaciones
  cierresDeCaja CierreDeCaja[]

  @@index([estadoLaboral])
}

enum Turno {
  MANANA
  TARDE
  NOCHE
}

enum EstadoLaboral {
  ACTIVO
  INACTIVO
  LICENCIA
}

// ============================================================================
// MEMBRESÍAS
// ============================================================================

model Membresia {
  id            String   @id @default(cuid())
  nombre        String
  precio        Decimal  @db.Decimal(10, 2)
  periodicidad  Int      // días
  descripcion   String?
  estado        EstadoMembresia @default(ACTIVA)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  socios        Socio[]  @relation("MembresiaDelSocio")
  cuotas        Cuota[]

  @@index([estado])
}

enum EstadoMembresia {
  ACTIVA
  INACTIVA
}

// ============================================================================
// CUOTAS
// ============================================================================

model Cuota {
  id                String   @id @default(cuid())
  socio             Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  socioId           String
  /// Inicio del tramo cubierto. Fin del tramo: `fechaVencimiento`, siempre el último instante de un mes (D-40).
  fechaInicio       DateTime @default(now())
  fechaVencimiento  DateTime
  estado            EstadoCuotaModel @default(VIGENTE)
  /// Plan que se pagó (queda aunque el socio cambie de plan después). Nulo en cuotas anteriores a D-40.
  membresia         Membresia? @relation(fields: [membresiaId], references: [id], onDelete: SetNull)
  membresiaId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  pagos             Pago[]

  @@index([socioId])
  @@index([fechaVencimiento])
  @@index([estado])
  @@index([membresiaId])
}

enum EstadoCuotaModel {
  VIGENTE
  VENCIDA
}

// ============================================================================
// PAGOS
// ============================================================================

model Pago {
  id                String   @id @default(cuid())
  fechaPago         DateTime @default(now())
  monto             Decimal  @db.Decimal(10, 2)
  metodoPago        MetodoPago
  estado            EstadoPago @default(CONFIRMADO)
  /// Precio de lista antes del descuento de la oferta; nulo si el pago no tuvo oferta (D-54)
  montoLista        Decimal? @db.Decimal(10, 2)
  /// Porcentaje de la oferta aplicada; nulo si el pago no tuvo oferta (D-54)
  descuentoPct      Decimal? @db.Decimal(5, 2)
  cuota             Cuota?   @relation(fields: [cuotaId], references: [id], onDelete: SetNull)
  cuotaId           String?
  socio             Socio?   @relation("PagosDeSocio", fields: [socioId], references: [id], onDelete: SetNull) // relación opcional para pagos fuera de cuota
  socioId           String?
  cierreDeCaja      CierreDeCaja? @relation(fields: [cierreDeCajaId], references: [id], onDelete: SetNull)
  cierreDeCajaId    String?
  createdAt         DateTime @default(now())

  @@index([fechaPago])
  @@index([estado])
  @@index([metodoPago])
  @@index([cuotaId])
  @@index([socioId])
  @@index([cierreDeCajaId])
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum EstadoPago {
  CONFIRMADO
  PENDIENTE
  ANULADO
}

// ============================================================================
// EJERCICIOS
// ============================================================================

model Ejercicio {
  id            String   @id @default(cuid())
  nombre        String
  grupoMuscular String
  descripcion   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Catálogo importado del dataset (D-70). Todos opcionales: los ejercicios cargados a mano
  // y los del seed siguen siendo válidos sin ellos.
  datasetId           String?  @unique       // id del dataset ("0001"); clave del importador idempotente
  equipamiento        String?                // en español: "Mancuerna", "Peso corporal"...
  musculoObjetivo     String?                // en español: "Pectorales"
  musculosSecundarios String[] @default([])
  instrucciones       String[] @default([])  // un paso por elemento
  mediaId             String?                // nombre base de los archivos en public/ejercicios ("0001-2gPfomN")

  // Relaciones
  rutinas       EjercicioEnRutina[]
  registrosProgreso RegistroDeProgreso[]
  maquinas      EjercicioMaquina[]
  asignaciones  AsignacionDeEjercicio[]

  @@index([grupoMuscular])
  @@index([equipamiento])
}

// ============================================================================
// RUTINAS
// ============================================================================

model Rutina {
  id                String   @id @default(cuid())
  nombre            String
  objetivoPrincipal String
  frecuenciaSemanal Int      // 1-7 días
  duracionEstimada  Int      // minutos
  nivelDeDificultad NivelDeDificultad
  descripcion       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  ejercicios        EjercicioEnRutina[]
  asignaciones      RutinaAsignada[]   // plantilla reutilizable
}

enum NivelDeDificultad {
  BASICO
  INTERMEDIO
  AVANZADO
}

// ============================================================================
// EJERCICIOS EN RUTINA (Relación)
// ============================================================================

model EjercicioEnRutina {
  id            String   @id @default(cuid())
  rutina        Rutina   @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  rutinaId      String
  ejercicio     Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)
  ejercicioId   String
  series        Int
  repeticiones  Int
  descanso      Int      // segundos
  orden         Int      @default(0) // para reordenar
  createdAt     DateTime @default(now())
  // Significa "último cambio de series o repeticiones": el motor de progresión (D-59) no juzga las
  // sesiones anteriores. `sincronizarEjercicios` (src/api/rutinas.ts, D-61) lo conserva si solo
  // cambian el descanso o el orden; no escribas filas de esta tabla sin pasar por ahí.
  updatedAt     DateTime @updatedAt

  @@unique([rutinaId, ejercicioId])
  @@index([rutinaId])
  @@index([ejercicioId])
}

// ============================================================================
// RUTINAS ASIGNADAS (Relación Socio ↔ Rutina)
// ============================================================================

model RutinaAsignada {
  id                String   @id @default(cuid())
  socio             Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  socioId           String
  rutina            Rutina   @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  rutinaId          String
  fechaAsignacion   DateTime @default(now())
  activa            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  sesiones          SesionDeEntrenamiento[]

  @@index([socioId, activa]) // para queries eficientes de RN-04 (una sola activa por socio); enforcement a nivel de aplicación
  @@index([rutinaId])
  @@index([activa])
}

// ============================================================================
// MÁQUINAS
// ============================================================================

model Maquina {
  id              String   @id @default(cuid())
  nombre          String
  tipoEquipamiento TipoEquipamiento
  estado          EstadoMaquina @default(DISPONIBLE)
  ubicacion       String
  fechaAlta       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  ejercicios    EjercicioMaquina[]
  asignaciones  AsignacionDeEjercicio[]

  @@index([estado])
  @@index([tipoEquipamiento])
}

enum TipoEquipamiento {
  MAQUINA_GUIADA
  PESO_LIBRE
  CARDIO
}

enum EstadoMaquina {
  DISPONIBLE
  OCUPADA
  FUERA_DE_SERVICIO
  INACTIVA
}

// ============================================================================
// EJERCICIO EN MÁQUINA (Relación)
// ============================================================================

model EjercicioMaquina {
  id          String    @id @default(cuid())
  ejercicio   Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  ejercicioId String
  maquina     Maquina   @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  maquinaId   String
  createdAt   DateTime  @default(now())

  @@unique([maquinaId, ejercicioId])
  @@index([maquinaId])
  @@index([ejercicioId])
}

// ============================================================================
// ASISTENCIAS
// ============================================================================

model Asistencia {
  id                String   @id @default(cuid())
  fechaHora         DateTime @default(now())
  socio             Socio    @relation(fields: [socioId], references: [id], onDelete: Restrict)
  socioId           String
  estado            EstadoAlIngresar @default(PERMITIDO)  // PERMITIDO or DENEGADO
  razon             String?  // Free text reason for DENEGADO (e.g., "Cuota vencida", "Membresía vencida")
  /// Cómo se identificó el ingreso (D-47). MANUAL para los registros previos.
  metodo            MetodoIdentificacion @default(MANUAL)
  autorizadoExcepcionalmente Boolean @default(false)

  @@index([socioId])
  @@index([fechaHora])
  @@index([estado])
}

enum EstadoAlIngresar {
  PERMITIDO
  DENEGADO
}

enum MetodoIdentificacion {
  DNI_PIN
  MANUAL
  HUELLA
}

// ============================================================================
// SESIONES DE ENTRENAMIENTO
// ============================================================================

model SesionDeEntrenamiento {
  id                  String   @id @default(cuid())
  horaInicio          DateTime
  horaFin             DateTime?
  socio               Socio    @relation(fields: [socioId], references: [id], onDelete: Restrict)
  socioId             String
  rutinaAsignada      RutinaAsignada @relation(fields: [rutinaAsignadaId], references: [id], onDelete: Restrict)
  rutinaAsignadaId    String
  estadoDeFinalizacion EstadoSesion
  /// Ejercicio actual de la sesión para poder retomarla (D-44). Es el `Ejercicio.id`;
  /// null cuando ya se completaron todas las series.
  ejercicioActualId   String?
  /// Número de la serie en curso del `ejercicioActualId` (1-based); null al terminar (D-44).
  serieActual         Int?
  observaciones       String?
  createdAt           DateTime @default(now())

  // Relaciones
  registrosProgreso   RegistroDeProgreso[]
  asignaciones        AsignacionDeEjercicio[]

  @@index([socioId])
  @@index([rutinaAsignadaId])
  @@index([horaInicio])
}

enum EstadoSesion {
  EN_CURSO
  COMPLETADA
  INCOMPLETA
  ABANDONADA
}

// ============================================================================
// REGISTROS DE PROGRESO
// ============================================================================

/// Tipo de serie (D-64). Las filas anteriores a D-64 son NORMAL.
enum TipoSerie {
  /// Serie de trabajo.
  NORMAL
  /// No es una de las series que pide la rutina y no cuenta para progresión, marcas ni volumen.
  CALENTAMIENTO
  /// Serie de trabajo llevada al límite: cuenta como cualquier otra.
  HASTA_EL_FALLO
  /// Serie con la carga reducida a propósito: ocupa una serie de la rutina pero no se juzga por repeticiones.
  DROP_SET
}

model RegistroDeProgreso {
  id            String   @id @default(cuid())
  carga         Decimal  @db.Decimal(10, 2) // kg
  repeticiones  Int
  /// Peso corporal del socio (kg). Opcional: un registro por serie no siempre lo tiene (D-48).
  pesoCorporal  Decimal? @db.Decimal(10, 2)
  /// RIR (Repeticiones En Reserva): 0–5. Cuántas repeticiones quedaron sin hacer (D-48).
  rir           Int?
  /// Número de serie del ejercicio dentro de la sesión (1-based), al registrar por serie (D-48).
  numeroSerie   Int?
  /// Tipo de serie (D-64). CALENTAMIENTO no avanza la sesión (no tiene `numeroSerie`) ni cuenta para métricas.
  tipo          TipoSerie @default(NORMAL)
  fecha         DateTime @default(now())
  ejercicio     Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)
  ejercicioId   String
  socio         Socio    @relation(fields: [socioId], references: [id], onDelete: Restrict)
  socioId       String
  /// Sesión de entrenamiento a la que pertenece la serie (D-48). SetNull: el historial sobrevive.
  sesion        SesionDeEntrenamiento? @relation(fields: [sesionId], references: [id], onDelete: SetNull)
  sesionId      String?

  @@index([ejercicioId])
  @@index([socioId])
  @@index([fecha])
  @@index([sesionId])
}

// ============================================================================
// PESO CORPORAL
// ============================================================================

/// Un pesaje del socio (D-65). La evolución y la meta se arman con todos ellos.
model MedicionDePeso {
  id        String   @id @default(cuid())
  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  socioId   String
  /// kg, hasta dos decimales.
  peso      Decimal  @db.Decimal(5, 2)
  fecha     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([socioId, fecha])
}

// ============================================================================
// REGLAS DE PROGRESIÓN
// ============================================================================

model ReglaDeProgresion {
  id                String   @id @default(cuid())
  tipo              TipoProgresion
  incrementoSugerido Decimal @db.Decimal(10, 2) // kg

  @@index([tipo])
}

enum TipoProgresion {
  LINEAL
  ONDULANTE
}

// ============================================================================
// CIERRES DE CAJA
// ============================================================================

model CierreDeCaja {
  id                String   @id @default(cuid())
  totalRecaudado    Decimal  @db.Decimal(10, 2)
  totalEfectivo     Decimal  @db.Decimal(10, 2)
  totalTransferencia Decimal @db.Decimal(10, 2)
  totalTarjeta      Decimal  @db.Decimal(10, 2)
  cantidadOperaciones Int
  observaciones     String?
  responsable       Empleado @relation(fields: [responsableId], references: [id], onDelete: Restrict)
  responsableId     String
  pagos             Pago[]   // relación a los pagos asociados a este cierre
  createdAt         DateTime @default(now())

  @@index([responsableId])
  @@index([createdAt])
}

// ============================================================================
// AUDITORÍA
// ============================================================================

model RegistroDeAuditoria {
  id              String   @id @default(cuid())
  tipoOperacion   TipoOperacion
  fechaHora       DateTime @default(now())
  responsable     Usuario  @relation(fields: [responsableId], references: [id], onDelete: Restrict)
  responsableId   String
  detalles        String?  // JSON stringified details

  @@index([tipoOperacion])
  @@index([fechaHora])
  @@index([responsableId])
}

enum TipoOperacion {
  ALTA
  BAJA
  MODIFICACION
  ANULACION
}

// ============================================================================
// ACCESO Y AUDITORÍA DE ACCESO (AuditoriaAcceso — append-only access log)
// ============================================================================

model AuditoriaAcceso {
  id            String   @id @default(cuid())
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId     String?  // nullable for failed logins
  socio         Socio?   @relation(fields: [socioId], references: [id], onDelete: SetNull)
  socioId       String?  // nullable for login actions
  accion        AccionAcceso
  motivo        String?  // requerido en OVERRIDE_GRANT; también lo escriben LOGIN, CHECK_IN y ACCESS_DENIED; null cuando no aplica
  resultado     ResultadoAcceso
  timestamp     DateTime @default(now())
  ipAddress     String   // IPv4/IPv6
  userAgent     String   // User-Agent header
  createdAt     DateTime @default(now())

  @@index([accion])
  @@index([resultado])
  @@index([timestamp])
  @@index([usuarioId])
  @@index([socioId])
}

enum AccionAcceso {
  LOGIN
  CHECK_IN
  OVERRIDE_GRANT
  MANUAL_DENY
  ACCESS_DENIED // acceso a una ruta/acción sin permiso (RBAC), con sesión válida
}

enum ResultadoAcceso {
  ALLOW
  DENY
}

// ============================================================================
// DISPOSITIVOS (puerta / recepción) — T-036, D-43 propuesta 4
// ============================================================================

/// Pantalla de puerta y controladores con autenticación propia (token con hash, nunca en claro).
model Dispositivo {
  id             String            @id @default(cuid())
  nombre         String
  tipo           TipoDispositivo   @default(PUERTA)
  tokenHash      String            @unique // bcrypt hash; NUNCA se guarda el token en claro
  // Selector de búsqueda (AC-7): primeros 8 chars del token. Evita comparar bcrypt contra TODOS
  // los dispositivos. Nullable porque la columna es aditiva (dispositivos viejos no lo tienen);
  // los nuevos lo guardan al crear. No es un secreto: es sólo el prefijo.
  tokenPrefix    String?
  estado         EstadoDispositivo @default(ACTIVO)
  ultimoContacto DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([estado])
  @@index([tokenPrefix])
}

enum TipoDispositivo {
  PUERTA
  RECEPCION
}

enum EstadoDispositivo {
  ACTIVO
  INACTIVO
}

// ============================================================================
// CONFIGURACIÓN DEL SISTEMA
// ============================================================================

model ConfiguracionDelSistema {
  id                    String   @id @default(cuid())
  capacidadMaxima       Int
  periodoGracia         Int      // días, default 0
  diasInactividad       Int      // para notificaciones
  descuentoReactivacion Decimal  @db.Decimal(5, 2) // %
  ventanaAforoMinutos   Int      @default(90)
  /// Día del mes hasta el que se puede pagar la cuota sin estar vencido (D-40)
  diaLimitePago         Int      @default(10)
  /// Último día del mes en que un alta paga prorrateo; después paga cuota completa (D-40)
  diaCorteAltaTardia    Int      @default(20)
  /// Ventana de anti-passback en minutos: no se permite un segundo ingreso dentro de ella (P-33)
  antiPassbackMinutos   Int      @default(60)
  /// Días sin asistir a partir de los cuales el socio puede recibir la oferta (D-54)
  diasSinAsistirParaOferta Int   @default(30)
  /// Días que deben pasar desde la última oferta usada para poder recibir otra (D-54)
  enfriamientoOfertaDias Int     @default(180)
  /// Interruptor de la oferta de reactivación: apagada, el cobro es idéntico al de siempre (D-54)
  ofertaReactivacionActiva Boolean @default(false)
  /// Duración estimada de una serie, en segundos, para el motor de espera (D-90)
  segundosEjecucionSerie Int     @default(60)
  /// Minutos que una reserva provisional espera antes de vencer (D-90)
  minutosVencimientoReserva Int  @default(15)
  /// Minutos de inactividad tras los cuales una sesión deja de ocupar su máquina (D-105)
  minutosInactividadSesion Int   @default(30)
  updatedAt             DateTime @updatedAt
}

// ============================================================================
// RATE LIMITING
// ============================================================================

model RateLimitLog {
  id        String   @id @default(cuid())
  key       String   // userId or IP address
  route     String   // base path being accessed (e.g., /api/socios, /api/auth/login)
  timestamp DateTime @default(now())

  // Indexes for efficient sliding-window queries and cleanup
  @@index([key, route, timestamp])
  @@index([timestamp])
}

// ============================================================================
// REVOCACIÓN DE TOKENS (P-06, D-34)
// ============================================================================

/// Token de sesión (jti del JWT) cerrado antes de vencer. El proxy rechaza los jti de esta tabla.
/// `expiraEn` es el vencimiento del token: pasado ese momento la fila ya no sirve y se borra.
model TokenRevocation {
  jti        String   @id
  usuarioId  String?
  expiraEn   DateTime
  revocadoEn DateTime @default(now())

  @@index([expiraEn])
}

// ============================================================================
// REFRESH TOKENS (P-20)
// ============================================================================

/// Token de refresco opaco para extender la sesión sin volver a pedir credenciales.
/// Se guarda el hash bcrypt, nunca el token en claro (como `Dispositivo.tokenHash`).
/// Rotación: cada uso revoca el token presentado (`revokedAt`) y deja un puntero al nuevo
/// (`replacedByTokenId`). Si se presenta un token ya revocado, se asume robo y se revoca
/// toda la cadena vigente del usuario.
model RefreshToken {
  id                String    @id @default(cuid())
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId         String
  /// bcrypt del token opaco. Nunca se guarda ni se loguea el token en claro.
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  /// id del token que reemplazó a este tras la rotación (para reconstruir la cadena).
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiresAt])
}

// ============================================================================
// ASIGNACIÓN DE EJERCICIO (Etapa 4: reservas y ocupación del motor de espera)
// ============================================================================

/// `VENCIDA` no se persiste: se deriva de `RESERVADA` con `venceEn <= ahora` (D-96, D-105).
enum EstadoAsignacion {
  RESERVADA
  EN_CURSO
  COMPLETADA
  CANCELADA
}

model AsignacionDeEjercicio {
  id             String   @id @default(cuid())
  socio          Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  socioId        String
  ejercicio      Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  ejercicioId    String
  maquina        Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)
  maquinaId      String?
  sesion         SesionDeEntrenamiento? @relation(fields: [sesionId], references: [id], onDelete: SetNull)
  sesionId       String?
  estado         EstadoAsignacion
  esperaSegundos Int
  ahorroSegundos Int
  creadaEn       DateTime
  venceEn        DateTime

  @@index([socioId, estado, venceEn])
  @@index([maquinaId, estado, creadaEn])
  @@index([sesionId])
  @@index([ejercicioId])
}
